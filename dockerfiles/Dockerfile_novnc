FROM ros:jazzy

ENV TZ=UTC
ENV SIZEW=1920
ENV SIZEH=1080
ENV REFRESH=60
ENV DPI=96
ENV CDEPTH=24
ENV VGL_DISPLAY=egl
ENV PASSWD=mypasswd
ENV NOVNC_ENABLE=false
ENV WEBRTC_ENCODER=nvh264enc
ENV WEBRTC_ENABLE_RESIZE=false
ENV ENABLE_AUDIO=true
ENV ENABLE_BASIC_AUTH=true

ARG NOVNC_VERSION=1.3.0

RUN apt-get clean && \
    apt-get update && apt-get install --no-install-recommends -y locales &&\
    rm -rf /var/lib/apt/lists/* && \
    locale-gen en_US.UTF-8

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update

RUN apt-get install --no-install-recommends -y \
        software-properties-common \
        alsa-utils \
        apt-transport-https \
        apt-utils \
        build-essential \
        ca-certificates \
        cups-filters \
        cups-common \
        cups-pdf \
        curl \
        file \
        wget \
        xz-utils \
        zstd \
        gcc \
        git \
        jq \
        python3 \
        supervisor \
        net-tools \
        xserver-xorg-input-all \
        xserver-xorg-video-all \
        xdg-utils \
        dbus-x11 \
        xkb-data \
        x11-xkb-utils \
        x11-xserver-utils \
        x11-utils \
        x11-apps \
        xauth \
        xbitmaps \
        xinit \
        xfonts-base \
        libxrandr-dev \
        xvfb

ENV XDG_CURRENT_DESKTOP=KDE
ENV KWIN_COMPOSE=N
ENV SUDO_EDITOR=kate
ENV PULSE_SERVER=unix:/run/pulse/native

RUN apt-get update && apt-get install --no-install-recommends -y \
        kde-plasma-desktop \
        terminator \
        kinfocenter \
        kwin-x11 \
        plasma-desktop \
        plasma-nm \
        plasma-widgets-addons \
        plasma-workspace \
        autoconf \
        automake \
        autotools-dev \
        chrpath \
        debhelper \
        git \
        python3 \
        python3-pip \
        python-is-python3 \
        libc6-dev \
        libcairo2-dev \
        libjpeg-turbo8-dev \
        libssl-dev \
        libv4l-dev \
        libvncserver-dev \
        libtool-bin \
        libxdamage-dev \
        libxinerama-dev \
        libxrandr-dev \
        libxss-dev \
        libxtst-dev \
        libavahi-client-dev && \
    rm -rf /var/lib/apt/lists/*  && \
    git clone "https://github.com/LibVNC/x11vnc.git" /tmp/x11vnc && \
    cd /tmp/x11vnc && autoreconf -fi && ./configure && make install && cd / && rm -rf /tmp/* && \
    curl -fsSL "https://github.com/novnc/noVNC/archive/v${NOVNC_VERSION}.tar.gz" | tar -xzf - -C /opt && \
    mv -f "/opt/noVNC-${NOVNC_VERSION}" /opt/noVNC && \
    ln -snf /opt/noVNC/vnc.html /opt/noVNC/index.html && \
    git clone "https://github.com/novnc/websockify.git" /opt/noVNC/utils/websockify

RUN apt-get update && apt-get install -y \
         ros-jazzy-desktop \
         ros-jazzy-moveit \
         ros-jazzy-ur \
         ros-jazzy-ur-robot-driver \
         ros-jazzy-usb-cam \
         ros-jazzy-image-tools \
         ros-jazzy-rqt-image-view \
         ros-jazzy-cv-bridge \
         ros-jazzy-control-msgs \
         ros-jazzy-xacro \
         ros-jazzy-rmw-cyclonedds-cpp \
         python3-colcon-common-extensions \
         python3-rosdep \
         python3-opencv \
         apt-utils \
         nmap \
         htop

RUN pip install --break-system-packages tensorboard

# ur_rtde (solo necesario para la pinza real). En x86 hay rueda precompilada; en ARM
# (Raspberry, Mac con Apple Silicon...) se compila desde código. Si falla, la simulación sigue funcionando.
RUN apt-get update && apt-get install -y --no-install-recommends cmake libboost-all-dev python3-dev && \
    (pip install --break-system-packages ur_rtde || echo "AVISO: no se pudo instalar ur_rtde; la pinza real no estará disponible") && \
    rm -rf /var/lib/apt/lists/*

# OpenCode 2 (agente de IA para terminal), siempre la última versión. Se instala
# como root en /usr/local/bin para que esté disponible para cualquier usuario/shell.
RUN curl -fsSL https://opencode.ai/v2/install -o /tmp/opencode-install.sh && \
    bash /tmp/opencode-install.sh --no-modify-path && \
    mv /root/.opencode/bin/opencode /usr/local/bin/opencode && \
    rm -rf /tmp/opencode-install.sh /root/.opencode && \
    opencode --version

# La imagen base de Ubuntu 24.04 trae un usuario "ubuntu" con uid 1000
RUN (userdel -r ubuntu || true) && \
    (groupdel ubuntu || true) && \
    apt-get update && apt-get install --no-install-recommends -y \
                sudo && \
            rm -rf /var/lib/apt/lists/* && \
            groupadd -g 1000 laboratorio && \
            useradd -ms /bin/bash laboratorio -u 1000 -g 1000 && \
            usermod -a -G adm,audio,cdrom,dialout,dip,floppy,plugdev,sudo,tape,video laboratorio && \
            echo "laboratorio ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && \
            chown laboratorio:laboratorio /home/laboratorio && \
            mkdir -p /var/run/laboratorio/1000 && \
            chown laboratorio:laboratorio /var/run/laboratorio/1000 && \
            echo "laboratorio:laboratorio" | chpasswd && \
            ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime && echo "$TZ" > /etc/timezone

COPY entrypoint.sh /etc/entrypoint.sh
RUN chmod 755 /etc/entrypoint.sh
COPY supervisord.conf /etc/supervisord.conf
RUN chmod 755 /etc/supervisord.conf

RUN sed -i "s/\r$//" /etc/entrypoint.sh

RUN echo "source /opt/ros/jazzy/setup.bash" >> /home/laboratorio/.bashrc && \
    echo "[ -f ~/ros_workspace/install/setup.bash ] && source ~/ros_workspace/install/setup.bash" >> /home/laboratorio/.bashrc

USER laboratorio
ENV SHELL /bin/bash
ENV USER=laboratorio
ENV DISPLAY=:0

ENTRYPOINT ["/usr/bin/supervisord"]
